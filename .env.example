# Copy to services/api/.env and fill in real values. Never commit .env.
NODE_ENV=development
PORT=4000
# Local PostgreSQL 18. Replace YOUR_PASSWORD with your postgres password.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/anbu_ai?schema=public
# Separate database used by automated tests (created by the migrate step).
DATABASE_URL_TEST=postgresql://postgres:YOUR_PASSWORD@localhost:5432/anbu_ai_test?schema=public
# Comma-separated origins allowed by CORS (Expo web dev server).
CORS_ORIGINS=http://localhost:8081
APP_NAME=Anbu AI
DEFAULT_TIMEZONE=Asia/Kolkata
LOG_LEVEL=info
# HMAC key for access tokens, at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
# Reminder worker (runs inside the API process). Due reminders are checked every N seconds.
REMINDER_WORKER_ENABLED=true
REMINDER_POLL_SECONDS=30
